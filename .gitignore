```gitignore
# Dependencies
node_modules/

# Build artifacts
dist/
build/
*.js.map

# Environment variables
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/

# Logs and temporary files
*.log
*.tmp
*.swp

# Python (if applicable)
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
.venv/
.env
.env.local

# Coverage reports
coverage/
htmlcov/
.coverage

# OS generated files
.DS_Store
Thumbs.db

# Testing
.nyc_output/
coverage/
junit.xml

# Compiled files
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.out
```